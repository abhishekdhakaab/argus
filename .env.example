# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=argus
POSTGRES_PORT=5432
DB_DSN=postgresql://postgres:replace-with-a-local-password@localhost:5432/argus

# Demo authentication
DEV_AUTH_PASSWORD=replace-with-a-local-password
JWT_PRIVATE_KEY_PATH=private.pem
JWT_PUBLIC_KEY_PATH=public.pem
JWT_PRIVATE_KEY_FILE=./gateway/private.pem
JWT_PUBLIC_KEY_FILE=./gateway/public.pem
JWT_ISSUER=argus-gateway

# OpenAI-compatible LLM endpoint (the defaults target local Ollama)
OPENAI_API_KEY=ollama
OPENAI_CHAT_COMPLETIONS_URL=http://host.docker.internal:11434/v1/chat/completions
SYNTHESIS_MODEL=command-r:35b
PLANNER_MODEL=command-r:35b

# Optional local overrides
ARGUS_HF_CACHE=/private/tmp/argus-hf-cache
FASTAPI_URL=http://127.0.0.1:8080
OTLP_ENDPOINT=
